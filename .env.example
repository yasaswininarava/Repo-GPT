# Copy this file to .env and fill in the values on your computer.
# Do not commit .env, and do not paste these values into chat.

# Key from Google AI Studio: https://aistudio.google.com/apikey
# Use a project that does not have billing turned on.
GEMINI_API_KEY=

# Text model. Standard input and output for this model were free of charge
# on the Gemini pricing page when this project was written. Quotas can change.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Public repositories can load without it.
# A token raises the GitHub REST rate limit. No repository scopes are required
# for public read access. Create one at https://github.com/settings/tokens
GITHUB_TOKEN=
